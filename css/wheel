.wheel-wrapper{

    position:relative;

    width:100%;

    display:flex;

    justify-content:center;

    align-items:center;
filter:
    drop-shadow(0 0 12px rgba(255,215,0,.5));

}

#wheelCanvas{

    width:100%;
    max-width:420px;

    aspect-ratio:1/1;

}

.pointer{

    position:absolute;

    top:-5px;

    left:50%;

    transform:translateX(-50%);

    width:0;
    height:0;

    border-left:20px solid transparent;
    border-right:20px solid transparent;
    border-top:40px solid gold;

    z-index:100;
}
